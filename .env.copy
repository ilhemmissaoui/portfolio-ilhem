# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Google Analytics (optional - analytics is skipped when unset)
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=

# Google Search Console verification (optional)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
